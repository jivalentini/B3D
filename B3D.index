<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Catálogo · Base 3D</title>
<meta name="description" content="Catálogo de productos impresos en 3D - Base 3D, Santa Fe, Argentina">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Syne:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --bg-deep:#0d0e12; --bg-dark:#161920; --bg-card:#1c1f28;
    --accent-blue:#1a8cff; --accent-violet:#7a22ff; --accent-magenta:#e60067;
    --grad:linear-gradient(135deg,#1a8cff 0%,#7a22ff 50%,#e60067 100%);
    --grad-h:linear-gradient(135deg,#e60067 0%,#7a22ff 50%,#1a8cff 100%);
    --text-white:#ffffff; --text-secondary:#a0aab2; --text-dim:#5a6470;
    --border-subtle:rgba(160,170,178,.12); --border-accent:rgba(26,140,255,.35);
    --glass-bg:rgba(22,25,32,.65); --glass-border:rgba(255,255,255,.07);
    --shadow-accent:0 0 40px rgba(26,140,255,.18); --shadow-card:0 8px 32px rgba(0,0,0,.5);
    --ok:#22d3a6; --warn:#ffb020; --wa:#25d366;
    --radius:12px; --radius-lg:20px; --nav-h:72px;
    --font-display:'Orbitron',sans-serif; --font-body:'Syne',sans-serif; --font-mono:'JetBrains Mono',monospace;
    --transition:.3s cubic-bezier(.4,0,.2,1);
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{
    background:var(--bg-deep);color:var(--text-white);font-family:var(--font-body);line-height:1.6;min-height:100vh;overflow-x:hidden;
    background-image:
      radial-gradient(ellipse 60% 50% at 15% 10%,rgba(26,140,255,.14),transparent 70%),
      radial-gradient(ellipse 50% 50% at 85% 30%,rgba(230,0,103,.12),transparent 70%),
      linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),
      linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px);
    background-size:100% 100%,100% 100%,48px 48px,48px 48px;
    background-attachment:fixed;
  }
  img{display:block;max-width:100%}
  a{color:inherit}
  button{font:inherit;color:inherit}
  .wrap{max-width:1240px;margin:0 auto;padding:0 20px}
  ::selection{background:var(--accent-violet);color:#fff}

  /* ================= Puntero dinámico ================= */
  .has-cursor, .has-cursor *{cursor:none !important}
  .cursor-dot,.cursor-ring{position:fixed;top:0;left:0;pointer-events:none;z-index:9999;border-radius:50%;transform:translate(-50%,-50%);opacity:0;transition:opacity .3s}
  .cursor-dot{width:8px;height:8px;background:var(--grad);box-shadow:0 0 12px rgba(122,34,255,.9)}
  .cursor-ring{width:38px;height:38px;border:1.5px solid rgba(26,140,255,.7);transition:width .25s,height .25s,border-color .25s,background .25s,opacity .3s;mix-blend-mode:screen}
  .cursor-ring.hover{width:64px;height:64px;border-color:var(--accent-magenta);background:rgba(230,0,103,.08)}
  .cursor-ring.click{width:28px;height:28px;border-color:#fff}
  .cursor-trail{position:fixed;width:6px;height:6px;border-radius:50%;pointer-events:none;z-index:9998;transform:translate(-50%,-50%);background:var(--accent-violet);opacity:.5}
  .visible{opacity:1}

  /* ================= Navbar ================= */
  header{position:sticky;top:0;z-index:50;height:var(--nav-h);background:rgba(13,14,18,.72);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-bottom:1px solid var(--glass-border)}
  .nav{height:100%;display:flex;align-items:center;justify-content:space-between;gap:16px}
  .brand{display:flex;align-items:center;gap:10px;text-decoration:none}
  .brand-mark{width:38px;height:38px;border-radius:10px;background:var(--grad);display:grid;place-items:center;font-family:var(--font-display);font-weight:900;font-size:.8rem;box-shadow:var(--shadow-accent)}
  .brand-name{font-family:var(--font-display);font-weight:700;letter-spacing:2px;background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
  .nav-links{display:flex;gap:6px;list-style:none}
  .nav-links a{text-decoration:none;color:var(--text-secondary);font-size:.92rem;padding:8px 14px;border-radius:8px;transition:var(--transition)}
  .nav-links a:hover{color:#fff;background:rgba(255,255,255,.04)}
  .nav-links a.active{color:var(--accent-blue);background:rgba(26,140,255,.12)}
  .nav-wa{display:inline-flex;align-items:center;gap:8px;text-decoration:none;padding:9px 16px;border-radius:10px;border:1px solid var(--border-accent);font-size:.88rem;font-weight:600;transition:var(--transition)}
  .nav-wa:hover{background:rgba(26,140,255,.12);box-shadow:var(--shadow-accent)}

  /* ================= Hero ================= */
  .hero{padding:64px 0 28px;position:relative}
  .eyebrow{display:flex;align-items:center;gap:12px;font-family:var(--font-mono);font-size:.75rem;letter-spacing:3px;color:var(--accent-blue);text-transform:uppercase}
  .eyebrow::before{content:"";width:32px;height:2px;background:var(--grad)}
  .hero h1{font-family:var(--font-display);font-weight:900;font-size:clamp(2.2rem,6vw,4.2rem);line-height:1.05;margin-top:18px;letter-spacing:-1px}
  .grad-text{background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
  .hero p{color:var(--text-secondary);max-width:560px;margin-top:16px;font-size:1.05rem}
  .hero-orb{position:absolute;right:2%;top:30px;width:260px;height:260px;border-radius:50%;border:1.5px solid rgba(122,34,255,.5);pointer-events:none;animation:spin 30s linear infinite}
  .hero-orb::before,.hero-orb::after{content:"";position:absolute;inset:40px;border-radius:50%;border:1.5px solid rgba(230,0,103,.35)}
  .hero-orb::after{inset:90px;border-color:rgba(26,140,255,.5)}
  @keyframes spin{to{transform:rotate(360deg)}}
  .stats{display:flex;gap:40px;margin-top:32px;padding-top:24px;border-top:1px solid var(--border-subtle);flex-wrap:wrap}
  .stat b{display:block;font-family:var(--font-display);font-size:1.7rem;background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
  .stat span{font-family:var(--font-mono);font-size:.7rem;letter-spacing:2px;color:var(--text-dim);text-transform:uppercase}

  /* ================= Controles ================= */
  .controls{position:sticky;top:var(--nav-h);z-index:40;padding:16px 0;background:linear-gradient(var(--bg-deep) 70%,transparent);display:flex;flex-direction:column;gap:12px}
  .search-box{position:relative}
  .search-box svg{position:absolute;left:16px;top:50%;transform:translateY(-50%);color:var(--text-dim)}
  .search{width:100%;background:var(--glass-bg);backdrop-filter:blur(10px);border:1px solid var(--glass-border);color:#fff;padding:14px 16px 14px 46px;border-radius:var(--radius);font:inherit;font-size:1rem;outline:none;transition:var(--transition)}
  .search::placeholder{color:var(--text-dim)}
  .search:focus{border-color:var(--accent-blue);box-shadow:var(--shadow-accent)}
  .row{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
  .row-label{font-family:var(--font-mono);font-size:.7rem;letter-spacing:2px;color:var(--text-dim);text-transform:uppercase;margin-right:6px;min-width:110px}
  .chip{background:var(--bg-card);border:1px solid var(--border-subtle);color:var(--text-secondary);padding:7px 16px;border-radius:999px;font-size:.86rem;font-weight:500;transition:var(--transition)}
  .chip:hover{color:#fff;border-color:var(--border-accent)}
  .chip.active{background:var(--grad);border-color:transparent;color:#fff;box-shadow:0 0 20px rgba(122,34,255,.35)}
  .count{font-family:var(--font-mono);font-size:.78rem;color:var(--text-dim);letter-spacing:1px;padding:6px 0}

  /* ================= Grid / Cards ================= */
  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:22px;padding:10px 0 80px}
  .card{position:relative;background:var(--bg-card);border-radius:var(--radius-lg);overflow:hidden;display:flex;flex-direction:column;border:1px solid var(--glass-border);transition:transform var(--transition),box-shadow var(--transition);opacity:0;transform:translateY(16px);animation:rise .5s forwards}
  .card::before{content:"";position:absolute;inset:0;border-radius:inherit;padding:1px;background:var(--grad);-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude;opacity:0;transition:opacity var(--transition);pointer-events:none}
  .card:hover{transform:translateY(-6px);box-shadow:var(--shadow-card),0 0 40px rgba(122,34,255,.2)}
  .card:hover::before{opacity:1}
  @keyframes rise{to{opacity:1;transform:none}}
  .media{position:relative;aspect-ratio:1/1;background:var(--bg-dark);overflow:hidden}
  .media img{width:100%;height:100%;object-fit:cover;transition:transform .6s}
  .card:hover .media img{transform:scale(1.06)}
  .badge{position:absolute;top:12px;left:12px;font-family:var(--font-mono);font-size:.68rem;letter-spacing:1px;text-transform:uppercase;padding:5px 10px;border-radius:999px;backdrop-filter:blur(8px)}
  .badge.stock{background:rgba(34,211,166,.15);color:var(--ok);border:1px solid rgba(34,211,166,.4)}
  .badge.pedido{background:rgba(255,176,32,.15);color:var(--warn);border:1px solid rgba(255,176,32,.4)}
  .gal-ind{position:absolute;bottom:12px;right:12px;background:rgba(13,14,18,.75);border:1px solid var(--glass-border);font-size:.74rem;padding:5px 11px;border-radius:999px;backdrop-filter:blur(8px)}
  .body{padding:16px 18px 18px;display:flex;flex-direction:column;gap:4px;flex:1}
  .cat{font-family:var(--font-mono);font-size:.68rem;letter-spacing:2px;color:var(--accent-blue);text-transform:uppercase}
  .name{font-weight:700;font-size:1.08rem;line-height:1.3}
  .sku{font-family:var(--font-mono);font-size:.74rem;color:var(--text-dim)}
  .price{font-family:var(--font-display);font-weight:700;font-size:1.45rem;margin-top:8px}
  .avail{font-size:.85rem;font-weight:500}
  .avail.ok{color:var(--ok)} .avail.wait{color:var(--warn)}
  .actions{display:flex;gap:8px;margin-top:auto;padding-top:14px}
  .btn-wa{flex:1;display:inline-flex;align-items:center;justify-content:center;gap:8px;background:var(--grad);background-size:200% 200%;color:#fff;font-weight:700;text-decoration:none;padding:12px;border-radius:999px;border:none;font-size:.9rem;transition:background-position .5s,box-shadow var(--transition)}
  .btn-wa:hover{background-position:100% 0;box-shadow:0 0 28px rgba(230,0,103,.4)}
  .btn-wa svg{flex-shrink:0}
  .btn-sec{display:inline-flex;align-items:center;justify-content:center;padding:0 14px;border-radius:999px;border:1px solid var(--border-subtle);text-decoration:none;font-size:.8rem;color:var(--text-secondary);transition:var(--transition)}
  .btn-sec:hover{color:#fff;border-color:var(--accent-magenta)}

  .skeleton{height:440px;border-radius:var(--radius-lg);background:linear-gradient(90deg,var(--bg-card) 0%,#252936 50%,var(--bg-card) 100%);background-size:200% 100%;animation:sh 1.3s infinite}
  @keyframes sh{to{background-position:-200% 0}}
  .empty,.error{grid-column:1/-1;text-align:center;color:var(--text-secondary);padding:70px 0;font-family:var(--font-mono);font-size:.9rem}
  .error{color:#ff5c8a}

  /* ================= Modal ================= */
  .modal{position:fixed;inset:0;z-index:100;background:rgba(5,6,9,.9);backdrop-filter:blur(10px);display:none;align-items:center;justify-content:center;padding:16px}
  .modal.open{display:flex;animation:fade .25s}
  @keyframes fade{from{opacity:0}}
  .mbox{width:100%;max-width:920px;max-height:100%;display:flex;flex-direction:column;gap:14px}
  .mhead{display:flex;justify-content:space-between;align-items:center;gap:12px}
  .mhead h3{font-family:var(--font-display);font-size:1.1rem;letter-spacing:.5px}
  .close{width:42px;height:42px;border-radius:50%;background:var(--bg-card);border:1px solid var(--glass-border);font-size:1.1rem;flex-shrink:0;transition:var(--transition)}
  .close:hover{border-color:var(--accent-magenta)}
  .stage{position:relative;aspect-ratio:4/3;max-height:68vh;border-radius:var(--radius-lg);overflow:hidden;background:#000;border:1px solid var(--glass-border);display:flex;align-items:center;justify-content:center}
  .stage img{max-width:100%;max-height:100%;object-fit:contain}
  .stage iframe{width:100%;height:100%;border:0;background:#fff}
  .arrow{position:absolute;top:50%;transform:translateY(-50%);width:46px;height:46px;border-radius:50%;border:1px solid var(--glass-border);background:rgba(13,14,18,.7);font-size:1.4rem;transition:var(--transition)}
  .arrow:hover{background:var(--accent-violet)}
  .arrow.l{left:12px} .arrow.r{right:12px}
  .thumbs{display:flex;gap:8px;overflow-x:auto;padding-bottom:4px}
  .thumbs img{width:64px;height:64px;object-fit:cover;border-radius:10px;opacity:.45;border:2px solid transparent;flex-shrink:0;transition:var(--transition)}
  .thumbs img.on{opacity:1;border-color:var(--accent-violet)}
  .mfoot{display:flex;gap:10px;flex-wrap:wrap}
  .mfoot .btn-wa{min-width:220px}
  .loader{font-family:var(--font-mono);color:var(--text-secondary);font-size:.85rem}

  footer{border-top:1px solid var(--border-subtle);padding:28px 20px;text-align:center;color:var(--text-dim);font-family:var(--font-mono);font-size:.75rem;letter-spacing:1px}

  @media (max-width:860px){ .nav-links{display:none} .hero-orb{display:none} }
  @media (max-width:540px){
    .grid{grid-template-columns:1fr 1fr;gap:12px}
    .body{padding:12px}
    .name{font-size:.92rem}
    .price{font-size:1.1rem}
    .actions{flex-direction:column}
    .btn-sec{padding:8px}
    .btn-wa{font-size:.8rem;padding:10px}
    .row-label{min-width:100%}
    .stats{gap:24px}
    .nav-wa span{display:none}
  }
  @media (prefers-reduced-motion:reduce){ *{animation:none !important;transition:none !important} .card{opacity:1;transform:none} }
</style>
</head>
<body>

<div class="cursor-dot" id="cDot"></div>
<div class="cursor-ring" id="cRing"></div>

<header>
  <div class="wrap nav">
    <a class="brand" id="homeLink" href="#">
      <div class="brand-mark">B3D</div>
      <span class="brand-name">BASE 3D</span>
    </a>
    <ul class="nav-links">
      <li><a data-site="">Inicio</a></li>
      <li><a class="active" href="#catalogo">Catálogo</a></li>
      <li><a data-site="#nosotros">Nosotros</a></li>
      <li><a data-site="#contacto">Contacto</a></li>
    </ul>
    <a class="nav-wa" id="waTop" target="_blank" rel="noopener">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.5 14.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.4-.5c.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.2-.3-.2-.6-.4zM12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2z"/></svg>
      <span>Consultas</span>
    </a>
  </div>
</header>

<main class="wrap" id="catalogo">
  <section class="hero">
    <div class="hero-orb" aria-hidden="true"></div>
    <div class="eyebrow">Catálogo · Santa Fe, Argentina</div>
    <h1>Elegí tu pieza,<br><span class="grad-text">nosotros la</span><br>imprimimos.</h1>
    <p>Productos impresos en 3D listos para entregar o fabricados a pedido. Encontrá lo que buscás y encargalo directo por WhatsApp.</p>
    <div class="stats">
      <div class="stat"><b id="statTotal">0</b><span>Productos</span></div>
      <div class="stat"><b id="statStock">0</b><span>En stock</span></div>
      <div class="stat"><b id="statTime">48h</b><span>Producción mín.</span></div>
    </div>
  </section>

  <section class="controls">
    <div class="search-box">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input class="search" id="search" type="search" placeholder="Buscar por nombre o código…">
    </div>
    <div class="row" id="catFilters"><span class="row-label">Categoría</span></div>
    <div class="row" id="stateFilters"><span class="row-label">Disponibilidad</span></div>
  </section>

  <div class="count" id="count"></div>
  <section class="grid" id="grid">
    <div class="skeleton"></div><div class="skeleton"></div><div class="skeleton"></div><div class="skeleton"></div>
  </section>
</main>

<footer>© <span id="year"></span> BASE 3D · IMPRESIÓN 3D · SANTA FE, ARGENTINA</footer>

<div class="modal" id="modal" aria-hidden="true">
  <div class="mbox">
    <div class="mhead">
      <h3 id="mTitle"></h3>
      <button class="close" id="mClose" aria-label="Cerrar">✕</button>
    </div>
    <div class="stage" id="stage"></div>
    <div class="thumbs" id="thumbs"></div>
    <div class="mfoot" id="mFoot"></div>
  </div>
</div>

<script>
/* =====================================================
   CONFIGURACIÓN — editá solo esta parte
   ===================================================== */
const CONFIG = {
  // URL del CSV publicado de la pestaña "Catalogo_y_Stock"
  CSV_URL: "",
  // Tu WhatsApp: 54 + 9 + característica sin 0 + número sin 15. Ej: 549342XXXXXXX
  WHATSAPP: "5493420000000",
  // Opcional: API Key de Google Drive para el carrusel propio de fotos
  DRIVE_API_KEY: "",
  // Tu sitio principal (para los links del menú)
  SITIO_PRINCIPAL: "https://jivalentini.github.io/Base3D-Web/",
  TIEMPO_PRODUCCION: "48-72 hs",
  MENSAJE: (p) => `¡Hola! Me interesa encargar el producto ${p.nombre} [${p.sku}]`,
  MENSAJE_GENERAL: "¡Hola! Quería hacer una consulta sobre los productos de Base 3D."
};

/* ================= Utilidades ================= */
const $ = (s) => document.querySelector(s);
const esc = (s) => String(s ?? "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const norm = (s) => String(s ?? "").normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().trim();
const money = (n) => n == null || isNaN(n) ? "Consultar" :
  new Intl.NumberFormat("es-AR", {style:"currency", currency:"ARS", maximumFractionDigits:0}).format(n);
const waLink = (text) => `https://wa.me/${CONFIG.WHATSAPP}?text=${encodeURIComponent(text)}`;
const WA_ICON = `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.5 14.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.4-.5c.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.2-.3-.2-.6-.4zM12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2z"/></svg>`;

function parseCSV(text){
  const rows = []; let row = [], field = "", q = false;
  for (let i = 0; i < text.length; i++){
    const c = text[i], n = text[i+1];
    if (q){
      if (c === '"' && n === '"'){ field += '"'; i++; }
      else if (c === '"') q = false;
      else field += c;
    } else {
      if (c === '"') q = true;
      else if (c === ","){ row.push(field); field = ""; }
      else if (c === "\n" || c === "\r"){
        if (c === "\r" && n === "\n") i++;
        row.push(field); rows.push(row); row = []; field = "";
      } else field += c;
    }
  }
  if (field || row.length){ row.push(field); rows.push(row); }
  return rows.filter(r => r.some(v => v.trim() !== ""));
}

// "$7.600,00" / "7600" / "7,600.50" -> número
function toNumber(v){
  let s = String(v ?? "").replace(/[^\d,.\-]/g, "");
  if (!s) return null;
  if (s.includes(",") && s.includes(".")){
    s = s.lastIndexOf(",") > s.lastIndexOf(".") ? s.replace(/\./g,"").replace(",",".") : s.replace(/,/g,"");
  } else if (s.includes(",")){
    s = /,\d{1,2}$/.test(s) ? s.replace(",",".") : s.replace(/,/g,"");
  } else if (/\.\d{3}$/.test(s)){
    s = s.replace(/\./g,"");
  }
  const n = parseFloat(s);
  return isNaN(n) ? null : n;
}

const driveFileId = (url) => (String(url).match(/\/d\/([-\w]{20,})/) || String(url).match(/[?&]id=([-\w]{20,})/) || [])[1];
const driveFolderId = (url) => (String(url).match(/\/folders\/([-\w]{20,})/) || String(url).match(/[?&]id=([-\w]{20,})/) || [])[1];
const driveThumb = (id, w = 800) => `https://drive.google.com/thumbnail?id=${id}&sz=w${w}`;
function imageUrl(url, w = 800){
  if (!url) return "";
  if (/drive\.google\.com|docs\.google\.com/.test(url)){ const id = driveFileId(url); return id ? driveThumb(id, w) : ""; }
  return url;
}
const PLACEHOLDER = "data:image/svg+xml;utf8," + encodeURIComponent(
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400"><defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#1a8cff"/><stop offset=".5" stop-color="#7a22ff"/><stop offset="1" stop-color="#e60067"/></linearGradient></defs><rect width="400" height="400" fill="#161920"/><g fill="none" stroke="url(#g)" stroke-width="6" opacity=".7"><path d="M200 110 280 155v90l-80 45-80-45v-90z"/><path d="M120 155l80 45 80-45M200 200v90"/></g></svg>`);

/* ================= Lectura por encabezados ================= */
function findCol(headers, ...keys){
  const h = headers.map(norm);
  for (const k of keys){
    const exact = k.startsWith("=");
    const key = exact ? k.slice(1) : k;
    const i = h.findIndex(x => exact ? x === key : x.includes(key));
    if (i >= 0) return i;
  }
  return -1;
}

function mapRows(rows){
  const headers = rows[0];
  const col = {
    sku:    findCol(headers, "sku", "codigo"),
    foto:   findCol(headers, "url foto", "link foto", "foto"),
    drive:  findCol(headers, "drive", "galeria", "carpeta"),
    nombre: findCol(headers, "nombre"),
    cat:    findCol(headers, "categoria"),
    mw:     findCol(headers, "makerworld", "=link"),
    estado: findCol(headers, "estado"),
    stock:  findCol(headers, "cantidad", "stock"),
    precio: findCol(headers, "precio")
  };
  const get = (r, i) => i >= 0 ? (r[i] ?? "").trim() : "";
  return rows.slice(1).map(r => {
    let foto = get(r, col.foto);
    if (!/^https?:/.test(foto)){
      foto = r.find(v => /^https?:.*(drive\.google|\.jpe?g|\.png|\.webp)/i.test(v) && !/folders/.test(v)) || "";
    }
    const stock = toNumber(get(r, col.stock)) ?? 0;
    return {
      sku: get(r, col.sku), nombre: get(r, col.nombre), cat: get(r, col.cat) || "Otros",
      foto, drive: get(r, col.drive), mw: get(r, col.mw),
      inmediato: norm(get(r, col.estado)).includes("stock") && stock > 0,
      stock, precio: toNumber(get(r, col.precio))
    };
  }).filter(p => p.sku && p.nombre);
}

const DEMO = [
  {sku:"B3D-001", nombre:"Dragón articulado", cat:"Juguetes", foto:"", drive:"", mw:"", inmediato:true, stock:4, precio:12500},
  {sku:"B3D-002", nombre:"Maceta geométrica", cat:"Decoración", foto:"", drive:"", mw:"", inmediato:false, stock:0, precio:8900},
  {sku:"B3D-003", nombre:"Soporte para celular", cat:"Accesorios", foto:"", drive:"", mw:"", inmediato:true, stock:10, precio:5400},
  {sku:"B3D-004", nombre:"Lámpara Lithophane", cat:"Decoración", foto:"", drive:"", mw:"", inmediato:false, stock:0, precio:21000},
  {sku:"B3D-005", nombre:"Llavero personalizado", cat:"Llaveros", foto:"", drive:"", mw:"", inmediato:true, stock:25, precio:2500}
];

/* ================= Render ================= */
let PRODUCTS = [];
const state = { cat: "Todas", estado: "Todos", q: "" };

function buildFilters(){
  const cats = ["Todas", ...[...new Set(PRODUCTS.map(p => p.cat))].sort((a,b)=>a.localeCompare(b,"es"))];
  const make = (el, list, key) => {
    el.querySelectorAll(".chip").forEach(c => c.remove());
    list.forEach(v => {
      const b = document.createElement("button");
      b.className = "chip" + (state[key] === v ? " active" : "");
      b.textContent = v;
      b.onclick = () => { state[key] = v; buildFilters(); render(); };
      el.appendChild(b);
    });
  };
  make($("#catFilters"), cats, "cat");
  make($("#stateFilters"), ["Todos", "Stock Inmediato", "A Pedido"], "estado");
}

function animateNumber(el, to){
  const start = performance.now(), dur = 900;
  const tick = (t) => { const k = Math.min(1, (t - start) / dur); el.textContent = Math.round(to * (1 - Math.pow(1 - k, 3))); if (k < 1) requestAnimationFrame(tick); };
  requestAnimationFrame(tick);
}

function render(){
  const q = norm(state.q);
  const list = PRODUCTS.filter(p =>
    (state.cat === "Todas" || p.cat === state.cat) &&
    (state.estado === "Todos" || (state.estado === "Stock Inmediato" ? p.inmediato : !p.inmediato)) &&
    (!q || norm(p.nombre).includes(q) || norm(p.sku).includes(q))
  );
  $("#count").textContent = `// ${list.length} producto${list.length !== 1 ? "s" : ""}`;
  const grid = $("#grid");
  if (!list.length){ grid.innerHTML = `<div class="empty">No hay productos con esos filtros.</div>`; return; }

  grid.innerHTML = list.map((p, n) => {
    const idx = PRODUCTS.indexOf(p);
    const img = imageUrl(p.foto, 600) || PLACEHOLDER;
    const hasGal = !!driveFolderId(p.drive);
    return `
    <article class="card" style="animation-delay:${Math.min(n, 12) * 50}ms">
      <div class="media" data-gal="${idx}">
        <img src="${esc(img)}" alt="${esc(p.nombre)}" loading="lazy" onerror="this.src='${PLACEHOLDER}'">
        <span class="badge ${p.inmediato ? "stock" : "pedido"}">${p.inmediato ? "Stock inmediato" : "A pedido"}</span>
        ${hasGal ? `<span class="gal-ind">📷 Galería</span>` : ""}
      </div>
      <div class="body">
        <span class="cat">${esc(p.cat)}</span>
        <h2 class="name">${esc(p.nombre)}</h2>
        <span class="sku">${esc(p.sku)}</span>
        <div class="price">${money(p.precio)}</div>
        <div class="avail ${p.inmediato ? "ok" : "wait"}">
          ${p.inmediato ? `✓ ${p.stock} disponible${p.stock !== 1 ? "s" : ""}` : `⏱ Producción en ${CONFIG.TIEMPO_PRODUCCION}`}
        </div>
        <div class="actions">
          <a class="btn-wa" href="${waLink(CONFIG.MENSAJE(p))}" target="_blank" rel="noopener">${WA_ICON} Pedir por WhatsApp</a>
          ${p.mw ? `<a class="btn-sec" href="${esc(p.mw)}" target="_blank" rel="noopener">MakerWorld</a>` : ""}
        </div>
      </div>
    </article>`;
  }).join("");
  grid.querySelectorAll("[data-gal]").forEach(el => el.onclick = () => openGallery(PRODUCTS[+el.dataset.gal]));
}

/* ================= Galería ================= */
const galleryCache = {};
let gal = { imgs: [], i: 0 };

async function fetchFolderImages(folderId){
  if (galleryCache[folderId]) return galleryCache[folderId];
  const q = encodeURIComponent(`'${folderId}' in parents and mimeType contains 'image/' and trashed = false`);
  const res = await fetch(`https://www.googleapis.com/drive/v3/files?q=${q}&fields=files(id,name)&orderBy=name&pageSize=100&key=${CONFIG.DRIVE_API_KEY}`);
  if (!res.ok) throw new Error("Drive API " + res.status);
  const data = await res.json();
  return (galleryCache[folderId] = (data.files || []).map(f => f.id));
}

async function openGallery(p){
  const folder = driveFolderId(p.drive);
  $("#mTitle").textContent = `${p.nombre} · ${p.sku}`;
  $("#mFoot").innerHTML = `<a class="btn-wa" href="${waLink(CONFIG.MENSAJE(p))}" target="_blank" rel="noopener">${WA_ICON} Pedir por WhatsApp</a>`
    + (p.mw ? `<a class="btn-sec" href="${esc(p.mw)}" target="_blank" rel="noopener">MakerWorld</a>` : "");
  $("#thumbs").innerHTML = "";
  $("#modal").classList.add("open"); document.body.style.overflow = "hidden";
  bindHover($("#modal"));

  const main = imageUrl(p.foto, 1200);
  gal = { imgs: main ? [main] : [], i: 0 };

  if (folder && CONFIG.DRIVE_API_KEY){
    $("#stage").innerHTML = `<span class="loader">Cargando fotos…</span>`;
    try {
      (await fetchFolderImages(folder)).forEach(id => { const u = driveThumb(id, 1200); if (!gal.imgs.includes(u)) gal.imgs.push(u); });
    } catch(e){ return embedFolder(folder); }
    if (!gal.imgs.length) return embedFolder(folder);
    showSlide(0);
  } else if (folder){
    embedFolder(folder);
  } else {
    if (!gal.imgs.length) gal.imgs = [PLACEHOLDER];
    showSlide(0);
  }
}

function embedFolder(id){
  $("#thumbs").innerHTML = "";
  $("#stage").innerHTML = `<iframe src="https://drive.google.com/embeddedfolderview?id=${id}#grid" title="Galería de fotos" loading="lazy"></iframe>`;
}

function showSlide(i){
  const n = gal.imgs.length;
  gal.i = (i + n) % n;
  $("#stage").innerHTML = `<img src="${esc(gal.imgs[gal.i])}" alt="Foto ${gal.i + 1}" onerror="this.src='${PLACEHOLDER}'">`
    + (n > 1 ? `<button class="arrow l" aria-label="Anterior">‹</button><button class="arrow r" aria-label="Siguiente">›</button>` : "");
  $("#stage").querySelector(".l")?.addEventListener("click", () => showSlide(gal.i - 1));
  $("#stage").querySelector(".r")?.addEventListener("click", () => showSlide(gal.i + 1));
  $("#thumbs").innerHTML = n > 1 ? gal.imgs.map((u, k) =>
    `<img src="${esc(u.replace(/sz=w\d+/, "sz=w150"))}" class="${k === gal.i ? "on" : ""}" data-k="${k}" alt="">`).join("") : "";
  $("#thumbs").querySelectorAll("img").forEach(t => t.onclick = () => showSlide(+t.dataset.k));
  bindHover($("#modal"));
}

function closeGallery(){ $("#modal").classList.remove("open"); $("#stage").innerHTML = ""; document.body.style.overflow = ""; }
$("#mClose").onclick = closeGallery;
$("#modal").onclick = (e) => { if (e.target.id === "modal") closeGallery(); };
document.addEventListener("keydown", (e) => {
  if (!$("#modal").classList.contains("open")) return;
  if (e.key === "Escape") closeGallery();
  if (e.key === "ArrowLeft" && gal.imgs.length > 1) showSlide(gal.i - 1);
  if (e.key === "ArrowRight" && gal.imgs.length > 1) showSlide(gal.i + 1);
});
let tx = null;
$("#stage").addEventListener("touchstart", e => tx = e.touches[0].clientX, {passive:true});
$("#stage").addEventListener("touchend", e => {
  if (tx == null || gal.imgs.length < 2) return;
  const dx = e.changedTouches[0].clientX - tx;
  if (Math.abs(dx) > 40) showSlide(gal.i + (dx < 0 ? 1 : -1));
  tx = null;
});

/* ================= Puntero dinámico =================
   Punto con degradé + anillo que lo sigue con retardo,
   se agranda sobre botones/tarjetas y deja una estela.
   Se desactiva solo en celulares/tablets (pantalla táctil). */
const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
const dot = $("#cDot"), ring = $("#cRing");
let mx = innerWidth / 2, my = innerHeight / 2, rx = mx, ry = my;

function bindHover(scope = document){
  if (!finePointer) return;
  scope.querySelectorAll("a, button, .media, input, .chip").forEach(el => {
    if (el.dataset.cur) return; el.dataset.cur = 1;
    el.addEventListener("mouseenter", () => ring.classList.add("hover"));
    el.addEventListener("mouseleave", () => ring.classList.remove("hover"));
  });
}

if (finePointer){
  document.body.classList.add("has-cursor");
  const trail = Array.from({length: 6}, (_, k) => {
    const t = document.createElement("div"); t.className = "cursor-trail";
    t.style.opacity = (0.45 - k * 0.07).toFixed(2);
    t.style.width = t.style.height = (6 - k * 0.7) + "px";
    t.style.background = k % 2 ? "var(--accent-magenta)" : "var(--accent-blue)";
    document.body.appendChild(t); return {el: t, x: mx, y: my};
  });
  addEventListener("mousemove", e => { mx = e.clientX; my = e.clientY; dot.classList.add("visible"); ring.classList.add("visible"); });
  document.addEventListener("mouseleave", () => { dot.classList.remove("visible"); ring.classList.remove("visible"); });
  addEventListener("mousedown", () => ring.classList.add("click"));
  addEventListener("mouseup", () => ring.classList.remove("click"));
  (function loop(){
    rx += (mx - rx) * 0.16; ry += (my - ry) * 0.16;
    dot.style.transform = `translate(${mx}px,${my}px) translate(-50%,-50%)`;
    ring.style.transform = `translate(${rx}px,${ry}px) translate(-50%,-50%)`;
    let px = mx, py = my;
    trail.forEach(t => { t.x += (px - t.x) * 0.35; t.y += (py - t.y) * 0.35; t.el.style.transform = `translate(${t.x}px,${t.y}px) translate(-50%,-50%)`; px = t.x; py = t.y; });
    requestAnimationFrame(loop);
  })();
}

/* ================= Inicio ================= */
$("#search").addEventListener("input", (e) => { state.q = e.target.value; render(); bindHover($("#grid")); });
$("#waTop").href = waLink(CONFIG.MENSAJE_GENERAL);
$("#homeLink").href = CONFIG.SITIO_PRINCIPAL;
document.querySelectorAll("[data-site]").forEach(a => a.href = CONFIG.SITIO_PRINCIPAL + a.dataset.site);
$("#year").textContent = new Date().getFullYear();
$("#statTime").textContent = CONFIG.TIEMPO_PRODUCCION.split("-")[0].trim() + "h";

const _render = render;
render = function(){ _render(); bindHover(document); };

async function init(){
  try {
    if (!CONFIG.CSV_URL){
      PRODUCTS = DEMO;
    } else {
      const sep = CONFIG.CSV_URL.includes("?") ? "&" : "?";
      const res = await fetch(CONFIG.CSV_URL + sep + "t=" + Date.now());
      if (!res.ok) throw new Error("HTTP " + res.status);
      PRODUCTS = mapRows(parseCSV(await res.text()));
    }
    animateNumber($("#statTotal"), PRODUCTS.length);
    animateNumber($("#statStock"), PRODUCTS.filter(p => p.inmediato).length);
    buildFilters(); render();
  } catch (err){
    console.error(err);
    $("#grid").innerHTML = `<div class="error">No se pudo cargar el catálogo. Revisá que la pestaña esté publicada como CSV.</div>`;
  }
}
init();
</script>
</body>
</html>
